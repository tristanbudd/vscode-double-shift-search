{
  "name": "double-shift-search",
  "displayName": "Double Shift Search",
  "description": "DSS | Double Shift Search | JetBrains-Style Navigation | Open Search Everywhere",
  "version": "1.0.0",
  "publisher": "tristanbudd",
  "author": "Tristan Budd <https://github.com/tristanbudd>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristanbudd/vscode-double-shift-search.git"
  },
  "bugs": {
    "url": "https://github.com/tristanbudd/vscode-double-shift-search/issues"
  },
  "homepage": "https://github.com/tristanbudd/vscode-double-shift-search#readme",
  "keywords": [
    "search",
    "jetbrains",
    "vscode",
    "shift",
    "shortcut"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "doubleShiftSearch.search",
        "title": "Double Shift Search: Open Palette"
      }
    ],
    "keybindings": [
      {
        "command": "doubleShiftSearch.search",
        "key": "shift shift"
      }
    ],
    "configuration": {
      "title": "Double Shift Search",
      "properties": {
        "doubleShiftSearch.targetCommand": {
          "type": "string",
          "default": "workbench.action.quickOpen",
          "description": "The target command to execute when double pressing shift",
          "enum": [
            "workbench.action.quickTextSearch",
            "workbench.action.findInFiles",
            "workbench.action.quickOpen",
            "workbench.action.showCommands",
            "workbench.action.gotoSymbol"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.2.3",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  }
}
