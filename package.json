{
  "name": "double-shift-search",
  "displayName": "Double Shift Search",
  "description": "DSS | Double Shift Search | JetBrains-Style Navigation | Open Search Everywhere",
  "version": "1.0.4",
  "publisher": "tristanbudd",
  "author": "Tristan Budd <https://github.com/tristanbudd>",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristanbudd/vscode-double-shift-search.git"
  },
  "bugs": {
    "url": "https://github.com/tristanbudd/vscode-double-shift-search/issues"
  },
  "homepage": "https://github.com/tristanbudd/vscode-double-shift-search#readme",
  "keywords": [
    "search",
    "jetbrains",
    "vscode",
    "shift",
    "shortcut",
    "navigate",
    "quick open",
    "palette",
    "find",
    "double shift"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "doubleShiftSearch.search",
        "title": "Double Shift Search: Open Palette"
      }
    ],
    "keybindings": [
      {
        "command": "doubleShiftSearch.search",
        "key": "shift shift"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Double Shift Search",
      "properties": {
        "doubleShiftSearch.useSelectionAsQuery": {
          "type": "boolean",
          "default": false,
          "description": "Automatically pre-fill the search palette with the text currently selected in the active editor."
        },
        "doubleShiftSearch.excludeExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".zip",
            ".tar",
            ".gz",
            ".7z",
            ".rar",
            ".exe",
            ".dll",
            ".png",
            ".jpg",
            ".jpeg",
            ".gif",
            ".ico",
            ".pdf",
            ".mp4",
            ".mp3"
          ],
          "description": "A list of file extensions that should be completely ignored when performing a deep text search."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./ && npm run build-ext",
    "build-ext": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm-run-all -p watch:*",
    "watch:tsc": "tsc -watch -p ./",
    "watch:esbuild": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "npm run compile && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.1.0"
  }
}
